# Postgres. Local: docker compose up -d db. Produção: string do Neon.
DATABASE_URL="postgresql://marcapagina:marcapagina@localhost:5432/marcapagina"

# Segredo de assinatura da sessão. Gerar com: openssl rand -base64 48
SESSION_SECRET=""

# Escola usada quando o host não identifica um tenant por subdomínio.
# Em deploy single-tenant é a escola da coordenação.
ESCOLA_PADRAO_SLUG="escola-piloto"

# Segredo que autoriza o acionamento dos jobs de cron.
CRON_SECRET=""
