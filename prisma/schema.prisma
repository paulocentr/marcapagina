generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant ────────────────────────────────────────────────────────────
// Escola é a raiz do tenant. É o ÚNICO modelo de negócio sem escolaId,
// porque ela É o escolaId de todo o resto.
model Escola {
  id       String   @id @default(cuid())
  slug     String   @unique // resolve o tenant pelo subdomínio
  nome     String
  ativa    Boolean  @default(true)
  criadaEm DateTime @default(now())

  usuarios      Usuario[]
  papeis        Papel[]
  alunos        Aluno[]
  turmas        Turma[]
  anosLetivos   AnoLetivo[]
  logsAuditoria LogAuditoria[]
  categorias    Categoria[]
  localizacoes  Localizacao[]
  autores       Autor[]
  obras         Obra[]
  exemplares    Exemplar[]
  inventarios   Inventario[]
  itensDeInventario InventarioItem[]
  configuracaoDeCirculacao ConfiguracaoDeCirculacao?
  configuracoesPorSerie    ConfiguracaoPorSerie[]
  diasNaoLetivos           DiaNaoLetivo[]
  emprestimos              Emprestimo[]
  reservas                 Reserva[]
  penalidades              Penalidade[]
}

// ─── Acesso ────────────────────────────────────────────────────────────
model Usuario {
  id        String   @id @default(cuid())
  escolaId  String
  nome      String
  email     String
  senhaHash String
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  escola Escola         @relation(fields: [escolaId], references: [id])
  papeis UsuarioPapel[]

  @@unique([escolaId, email])
  @@index([escolaId])
}

model Papel {
  id        String @id @default(cuid())
  escolaId  String
  nome      String
  descricao String?
  // Permissões como String[]: o catálogo vive em código (fonte da
  // verdade, tipado), o banco guarda só a atribuição. Uma tabela de
  // permissões seria uma segunda fonte da verdade que sai de sincronia
  // com o código na primeira refatoração.
  permissoes String[]
  deSistema  Boolean  @default(false) // papel de fábrica: não pode ser excluído
  criadoEm   DateTime @default(now())

  escola   Escola         @relation(fields: [escolaId], references: [id])
  usuarios UsuarioPapel[]

  @@unique([escolaId, nome])
  @@index([escolaId])
}

model UsuarioPapel {
  usuarioId String
  papelId   String

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  papel   Papel   @relation(fields: [papelId], references: [id], onDelete: Cascade)

  @@id([usuarioId, papelId])
}

// ─── Leitores (mínimo necessário para autenticar; completa no plano 4) ──
model AnoLetivo {
  id         String   @id @default(cuid())
  escolaId   String
  ano        Int
  dataInicio DateTime
  dataFim    DateTime
  ativo      Boolean  @default(false)

  escola Escola  @relation(fields: [escolaId], references: [id])
  turmas Turma[]

  @@unique([escolaId, ano])
  @@index([escolaId])
}

model Turma {
  id          String @id @default(cuid())
  escolaId    String
  anoLetivoId String
  nome        String // "5º A"
  serie       String // "5" | "1EM" — usado no override de circulação por série
  turno       String

  escola    Escola    @relation(fields: [escolaId], references: [id])
  anoLetivo AnoLetivo @relation(fields: [anoLetivoId], references: [id])
  alunos    Aluno[]

  @@unique([escolaId, anoLetivoId, nome])
  @@index([escolaId])
}

model Aluno {
  id                  String   @id @default(cuid())
  escolaId            String
  matricula           String
  nome                String
  dataNascimento      DateTime @db.Date
  turmaId             String?
  responsavelNome     String?
  responsavelEmail    String?
  responsavelTelefone String?
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now())

  escola      Escola       @relation(fields: [escolaId], references: [id])
  turma       Turma?       @relation(fields: [turmaId], references: [id])
  emprestimos Emprestimo[]
  reservas    Reserva[]
  penalidades Penalidade[]

  @@unique([escolaId, matricula])
  @@index([escolaId])
}

// ─── Segurança e auditoria ─────────────────────────────────────────────
// Rate limit em banco, não em Redis: o free tier não tem Redis, e o
// volume de uma biblioteca escolar cabe folgadamente numa tabela com
// índice. Uma dependência a menos para operar.
model TentativaLogin {
  id            String   @id @default(cuid())
  escolaId      String? // nulo quando o tenant nem chegou a ser resolvido
  identificador String // e-mail (staff) ou matrícula (aluno)
  reino         String // "STAFF" | "ALUNO"
  ip            String
  sucesso       Boolean
  ocorridaEm    DateTime @default(now())

  @@index([identificador, reino, ocorridaEm])
  @@index([ip, ocorridaEm])
}

model LogAuditoria {
  id          String   @id @default(cuid())
  escolaId    String
  autorTipo   String // "STAFF" | "ALUNO" | "SISTEMA"
  autorId     String?
  autorNome   String
  acao        String // "emprestimo.forcar", "usuario.papel.alterar"
  entidade    String
  entidadeId  String?
  dadosAntes  Json?
  dadosDepois Json?
  ip          String?
  ocorridaEm  DateTime @default(now())

  escola Escola @relation(fields: [escolaId], references: [id])

  @@index([escolaId, ocorridaEm])
  @@index([escolaId, entidade, entidadeId])
}

// ─── Acervo (spec §4.2) ────────────────────────────────────────────────
enum EstadoDeConservacao {
  NOVO
  BOM
  DESGASTADO
  DANIFICADO
}

enum SituacaoDoExemplar {
  DISPONIVEL
  EMPRESTADO
  RESERVADO
  EM_CARRINHO
  EM_MANUTENCAO
  EXTRAVIADO
  BAIXADO
}

enum OrigemDoExemplar {
  COMPRA
  DOACAO
  GOVERNO
}

model Categoria {
  id       String  @id @default(cuid())
  escolaId String
  nome     String
  cor      String?
  parentId String?

  escola Escola      @relation(fields: [escolaId], references: [id])
  parent Categoria?  @relation("Hierarquia", fields: [parentId], references: [id])
  filhas Categoria[] @relation("Hierarquia")
  obras  Obra[]

  @@unique([escolaId, nome, parentId])
  @@index([escolaId])
}

model Localizacao {
  id         String  @id @default(cuid())
  escolaId   String
  nome       String
  corredor   String?
  estante    String?
  prateleira String?

  escola      Escola       @relation(fields: [escolaId], references: [id])
  exemplares  Exemplar[]
  inventarios Inventario[]

  @@unique([escolaId, nome])
  @@index([escolaId])
}

model Autor {
  id       String @id @default(cuid())
  escolaId String
  nome     String
  // Nome normalizado (minúsculas, sem acento) para deduplicar: "Clarice
  // Lispector" e "clarice lispector" são a MESMA pessoa, e sem isso o
  // relatório de autor mais lido conta a mesma autora duas vezes.
  nomeNormalizado String

  escola Escola      @relation(fields: [escolaId], references: [id])
  obras  ObraAutor[]

  @@unique([escolaId, nomeNormalizado])
  @@index([escolaId])
}

model Obra {
  id              String   @id @default(cuid())
  escolaId        String
  titulo          String
  // Título normalizado para busca insensível a acento e caixa. Coluna em
  // vez da extensão unaccent: uma extensão a menos é uma dependência a
  // menos entre o Neon de hoje e o Postgres de amanhã (spec §2.4).
  tituloNormalizado String
  subtitulo       String?
  editora         String?
  anoPublicacao   Int?
  isbn            String?
  edicao          String?
  idioma          String?
  numeroDePaginas Int?
  sinopse         String?
  // SEMPRE URL externa. Binário no banco não entra: o free tier do Neon
  // são 0,5 GB e capa de livro é o jeito mais rápido de gastá-los.
  capaUrl     String?
  cdd         String?
  faixaEtaria String?
  categoriaId String?
  criadaEm    DateTime @default(now())

  escola     Escola      @relation(fields: [escolaId], references: [id])
  categoria  Categoria?  @relation(fields: [categoriaId], references: [id])
  autores    ObraAutor[]
  exemplares Exemplar[]
  reservas   Reserva[]

  @@index([escolaId])
  @@index([escolaId, isbn])
  @@index([escolaId, tituloNormalizado])
}

model ObraAutor {
  obraId  String
  autorId String
  ordem   Int    @default(0)

  obra  Obra  @relation(fields: [obraId], references: [id], onDelete: Cascade)
  autor Autor @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@id([obraId, autorId])
}

model Exemplar {
  id               String              @id @default(cuid())
  escolaId         String
  obraId           String
  tombo            String
  estado           EstadoDeConservacao @default(BOM)
  situacao         SituacaoDoExemplar  @default(DISPONIVEL)
  localizacaoId    String?
  dataDeAquisicao  DateTime?
  origem           OrigemDoExemplar    @default(COMPRA)
  valorDeAquisicao Decimal?            @db.Decimal(10, 2)
  observacao       String?
  criadoEm         DateTime            @default(now())

  escola Escola @relation(fields: [escolaId], references: [id])
  // Restrict, não Cascade: excluir obra que tem exemplar tem que ser
  // recusado. Cascade transformaria um clique errado em acervo apagado.
  obra        Obra         @relation(fields: [obraId], references: [id], onDelete: Restrict)
  localizacao Localizacao? @relation(fields: [localizacaoId], references: [id])
  itensDeInventario InventarioItem[]
  emprestimos       Emprestimo[]
  reservas          Reserva[]

  @@unique([escolaId, tombo])
  @@index([escolaId])
  @@index([escolaId, obraId])
  @@index([escolaId, situacao])
}

// ─── Inventário (spec §4.5, §5.7) ──────────────────────────────────────
enum StatusDoInventario {
  ABERTO
  FECHADO
  CANCELADO
}

enum TipoDeDivergencia {
  NAO_ENCONTRADO
  FORA_DO_LUGAR
  CONSTA_EMPRESTADO
}

model Inventario {
  id       String  @id @default(cuid())
  escolaId String
  // Nulo = acervo inteiro. A conferência por localização é o caso comum:
  // a operadora percorre UMA estante por vez.
  localizacaoId   String?
  responsavelId   String
  responsavelNome String
  status          StatusDoInventario @default(ABERTO)
  iniciadoEm      DateTime           @default(now())
  fechadoEm       DateTime?

  escola      Escola           @relation(fields: [escolaId], references: [id])
  localizacao Localizacao?     @relation(fields: [localizacaoId], references: [id])
  itens       InventarioItem[]

  @@index([escolaId])
  @@index([escolaId, status])
}

model InventarioItem {
  id           String  @id @default(cuid())
  escolaId     String
  inventarioId String
  exemplarId   String
  // A situação no momento da abertura. Guardada porque é ela que decide,
  // no fechamento, se um exemplar ausente é perda ou empréstimo em curso
  // — e a situação de hoje já mudou quando o inventário fecha.
  situacaoNaAbertura String
  conferido          Boolean   @default(false)
  conferidoEm        DateTime?
  localizacaoEncontradaId String?
  divergencia             TipoDeDivergencia?

  escola     Escola     @relation(fields: [escolaId], references: [id])
  inventario Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  exemplar   Exemplar   @relation(fields: [exemplarId], references: [id], onDelete: Restrict)

  @@unique([inventarioId, exemplarId])
  @@index([escolaId])
  @@index([inventarioId, conferido])
}

// ─── Circulação (spec §4.3, §4.8) ──────────────────────────────────────
enum StatusDoEmprestimo {
  ATIVO
  DEVOLVIDO
  PERDIDO
}

enum StatusDaReserva {
  AGUARDANDO
  DISPONIVEL
  ATENDIDA
  EXPIRADA
  CANCELADA
}

enum TipoDePenalidade {
  SUSPENSAO
}

model ConfiguracaoDeCirculacao {
  id       String @id @default(cuid())
  escolaId String @unique

  prazoEmDias                Int
  limiteSimultaneo           Int
  maximoDeRenovacoes         Int
  diasDeSuspensaoPorDiaDeAtraso Int @default(1)
  prazoDeRetiradaEmDias      Int @default(2)
  alunoPodeReservar          Boolean @default(true)

  escola Escola @relation(fields: [escolaId], references: [id])
}

// Override POR SÉRIE. A escola vai do 1º ano do Fundamental ao 3º do
// Médio: um valor único estaria errado nas duas pontas ao mesmo tempo.
// Todo campo é opcional porque o override vale campo a campo — a série
// pode sobrescrever só o limite e herdar o resto.
model ConfiguracaoPorSerie {
  id       String @id @default(cuid())
  escolaId String
  serie    String

  prazoEmDias                   Int?
  limiteSimultaneo              Int?
  maximoDeRenovacoes            Int?
  diasDeSuspensaoPorDiaDeAtraso Int?
  prazoDeRetiradaEmDias         Int?
  alunoPodeReservar             Boolean?

  escola Escola @relation(fields: [escolaId], references: [id])

  @@unique([escolaId, serie])
  @@index([escolaId])
}

model DiaNaoLetivo {
  id       String   @id @default(cuid())
  escolaId String
  data     DateTime @db.Date
  motivo   String

  escola Escola @relation(fields: [escolaId], references: [id])

  // Feriado municipal não é o mesmo em toda cidade: a unicidade é POR
  // ESCOLA, nunca global.
  @@unique([escolaId, data])
  @@index([escolaId, data])
}

model Emprestimo {
  id         String @id @default(cuid())
  escolaId   String
  exemplarId String
  // Aluno OU usuário: staff também pega livro emprestado.
  alunoId   String?
  usuarioId String?

  retiradaEm   DateTime  @default(now())
  previstaPara DateTime  @db.Date
  // NÃO existe campo "atrasado" (Global Constraint 16). Ele é sempre
  // calculado: previstaPara < hoje AND devolvidaEm IS NULL. Um campo
  // materializado mente todo dia em que o cron falhar, e mente na direção
  // pior — dizendo que está tudo em ordem.
  devolvidaEm DateTime?

  renovacoes          Int                  @default(0)
  operadorRetiradaId  String
  operadorDevolucaoId String?
  estadoNaDevolucao   EstadoDeConservacao?
  observacao          String?

  liberacaoForcada         Boolean @default(false)
  justificativaDaLiberacao String?

  escola      Escola       @relation(fields: [escolaId], references: [id])
  exemplar    Exemplar     @relation(fields: [exemplarId], references: [id], onDelete: Restrict)
  aluno       Aluno?       @relation(fields: [alunoId], references: [id])
  penalidades Penalidade[]

  // Sustenta a consulta de atrasados, que roda no painel do dia.
  @@index([escolaId, devolvidaEm, previstaPara])
  @@index([escolaId, alunoId, devolvidaEm])
  @@index([escolaId, exemplarId])
}

model Reserva {
  id       String @id @default(cuid())
  escolaId String
  // A reserva é da OBRA, não do exemplar: o aluno quer o livro, e
  // qualquer cópia serve. Reservar exemplar específico faria a fila parar
  // porque justamente aquela cópia está com alguém.
  obraId  String
  alunoId String

  criadaEm            DateTime        @default(now())
  status              StatusDaReserva @default(AGUARDANDO)
  posicao             Int
  exemplarSeparadoId  String?
  retirarAte          DateTime?

  escola   Escola    @relation(fields: [escolaId], references: [id])
  obra     Obra      @relation(fields: [obraId], references: [id], onDelete: Restrict)
  aluno    Aluno     @relation(fields: [alunoId], references: [id])
  exemplar Exemplar? @relation(fields: [exemplarSeparadoId], references: [id])

  @@index([escolaId])
  @@index([escolaId, obraId, status, posicao])
  @@index([escolaId, status, retirarAte])
}

model Penalidade {
  id       String           @id @default(cuid())
  escolaId String
  alunoId  String
  tipo     TipoDePenalidade @default(SUSPENSAO)
  inicio   DateTime         @db.Date
  fim      DateTime         @db.Date
  motivo   String
  // Sem a origem, a suspensão vira um castigo sem história e ninguém
  // consegue explicar ao responsável de onde ela veio.
  emprestimoOrigemId String?

  escola           Escola      @relation(fields: [escolaId], references: [id])
  aluno            Aluno       @relation(fields: [alunoId], references: [id])
  emprestimoOrigem Emprestimo? @relation(fields: [emprestimoOrigemId], references: [id])

  @@index([escolaId])
  @@index([escolaId, alunoId, fim])
}
